{
	"author": "heap-code",
	"bugs": {
		"url": "https://github.com/heap-code/eslint-plugin-sort-decorators/issues"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"dependencies": {
		"@typescript-eslint/utils": "^8.0.0"
	},
	"description": "An ESLint plugin to sort decorators",
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@release-it/conventional-changelog": "^11.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@swc/core": "^1.3.67",
		"@types/jest": "^30.0.0",
		"@typescript-eslint/parser": "^8.71.2",
		"@typescript-eslint/rule-tester": "^8.71.2",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-doc-generator": "^3.7.1",
		"eslint-plugin-eslint-plugin": "^7.6.2",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jest": "^29.17.0",
		"eslint-plugin-jsdoc": "^65.3.12",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-markdownlint": "^1.0.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-sort-destructure-keys": "^3.0.0",
		"eslint-plugin-sort-exports": "^0.9.1",
		"eslint-plugin-sort-keys-plus": "^1.5.0",
		"eslint-plugin-unicorn": "^79.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"eslint-plugin-yml": "^3.9.0",
		"globals": "^17.13.0",
		"jest": "^30.0.0",
		"prettier-plugin-sh": "^0.20.0",
		"release-it": "^20.0.0",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.4",
		"ts-node": "^10.9.1",
		"tsup": "^9.0.0",
		"typescript": "^5.1.5",
		"typescript-eslint": "^8.71.2",
		"typescript-json-schema": "^0.68.0",
		"yaml-eslint-parser": "^2.1.0"
	},
	"homepage": "https://github.com/heap-code/eslint-plugin-sort-decorators",
	"keywords": [
		"eslint",
		"eslintplugin",
		"decorators",
		"sort",
		"plugin"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "eslint-plugin-sort-decorators",
	"peerDependencies": {
		"@typescript-eslint/parser": "^7.0.0 || ^8.0.0",
		"eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/heap-code/eslint-plugin-sort-decorators.git"
	},
	"scripts": {
		"build": "tsup-node --config ./tsup.config.ts",
		"docs:update": "npx eslint-doc-generator",
		"lint": "eslint .",
		"lint:fix": "npm run lint -- --fix",
		"postschemas:update": "eslint src/lib/sort-rule/sort-rule.options.schema.json --fix",
		"schemas:update": "typescript-json-schema src/lib/sort-rule/sort-rule.options.ts SortRuleOptions --noExtraProps --required --skipLibCheck -o src/lib/sort-rule/sort-rule.options.schema.json",
		"test": "jest --config jest.config.ts",
		"test:coverage": "npm run test -- --coverage",
		"test:watch": "npm run test -- --watch",
		"typecheck": "tsc --noEmit -p ./tsconfig.spec.json"
	},
	"types": "./dist/index.d.ts",
	"version": "0.5.0"
}
